# Jarvis Environment Variables

# ── Ollama (required) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Models to compare in benchmarks (comma-separated, no spaces)
BENCHMARK_MODELS=llama3.2:latest,mistral:7b

# ── Spotify (optional) ─────────────────────────────────────────────────────
# Get free credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ── ElevenLabs TTS (required for voice output) ─────────────────────────────
# Free tier: 10,000 characters/month. Sign up at https://elevenlabs.io
ELEVENLABS_API_KEY=
# George — British male, Jarvis-fit. Library: elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 (lowest latency) | eleven_turbo_v2_5 (higher quality)
ELEVENLABS_MODEL=eleven_flash_v2_5
USE_LOCAL_TTS=false

# ── Whisper STT (faster-whisper, local) ────────────────────────────────────
# tiny.en (fastest) | base.en | small.en (default) | medium.en (best accuracy)
WHISPER_MODEL=small.en

# ── Google APIs (optional) ─────────────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=~/.jarvis/credentials.json
GOOGLE_TOKEN_PATH=~/.jarvis/token.json

# ── Location for weather (defaults to London) ──────────────────────────────
DEFAULT_LATITUDE=51.5074
DEFAULT_LONGITUDE=-0.1278
DEFAULT_LOCATION_NAME=London

# ── Evaluator thresholds ───────────────────────────────────────────────────
EVALUATOR_MIN_SCORE=0.6
CRITIC_REPLAN_THRESHOLD=0.5

# ── Voice — hybrid stack (Whisper local STT + ElevenLabs TTS) ──────────────
# See VOICE_SETUP.md.

WAKE_WORD_ENABLED=true
WAKE_WORD_MODEL=hey_jarvis_v0.1
WAKE_WORD_THRESHOLD=0.5

VAD_THRESHOLD=0.5
END_SILENCE_MS=900
LISTEN_TIMEOUT_SECONDS=12

WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

BARGE_IN_ENABLED=true
AUDIO_SAMPLE_RATE=16000