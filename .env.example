# Jarvis Environment Variables

# ── Ollama (required) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Models to compare in benchmarks (comma-separated, no spaces)
BENCHMARK_MODELS=llama3.2:latest,mistral:7b

# ── Spotify (optional) ─────────────────────────────────────────────────────
# Get free credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ── ElevenLabs TTS (optional — free tier available) ────────────────────────
# Get key at: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Use local Piper TTS instead of ElevenLabs (true = free, false = ElevenLabs)
USE_LOCAL_TTS=true

# ── Whisper STT model size ─────────────────────────────────────────────────
# tiny (fastest) | base | small | medium (most accurate)
# On M2 Mac, 'base' is a good balance
WHISPER_MODEL=base

# ── Google APIs (optional) ─────────────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=~/.jarvis/credentials.json
GOOGLE_TOKEN_PATH=~/.jarvis/token.json

# ── Location for weather (defaults to London) ──────────────────────────────
DEFAULT_LATITUDE=51.5074
DEFAULT_LONGITUDE=-0.1278
DEFAULT_LOCATION_NAME=London

# ── Evaluator thresholds ───────────────────────────────────────────────────
EVALUATOR_MIN_SCORE=0.6
CRITIC_REPLAN_THRESHOLD=0.5