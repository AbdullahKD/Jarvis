# Don't ship local dev cruft to the image.
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.git/
.github/
.gitignore
.DS_Store

# Don't bake local secrets into the image — use Fly secrets instead.
.env

# Local data shouldn't be in the image — Fly volume covers it at runtime.
data/
logs/
*.db

# IDE
.idea/
.vscode/
*.swp

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Docs / one-off assets that aren't needed in the runtime image
jarvis_v1.zip
"FinEx Data"/
